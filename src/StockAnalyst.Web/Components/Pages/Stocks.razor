@page "/stocks"
@rendermode InteractiveServer
@using StockAnalyst.Core.Models
@using StockAnalyst.Core.Services
@inject IStockService StockService

<PageTitle>Stocks</PageTitle>

<h1>Stocks</h1>

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="alert alert-success alert-dismissible" role="alert">
        @_successMessage
        <button type="button" class="btn-close" @onclick="() => _successMessage = null" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @_errorMessage
        <button type="button" class="btn-close" @onclick="() => _errorMessage = null" aria-label="Close"></button>
    </div>
}

<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Add New Stock</h5>
    </div>
    <div class="card-body">
        <EditForm Model="_createModel" OnValidSubmit="HandleCreateAsync" FormName="createStock">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-sm-3">
                    <label for="symbol" class="form-label">Symbol</label>
                    <InputText id="symbol" class="form-control" @bind-Value="_createModel.Symbol" placeholder="e.g. AAPL" />
                    <ValidationMessage For="() => _createModel.Symbol" class="text-danger small" />
                </div>
                <div class="col-sm-5">
                    <label for="name" class="form-label">Name</label>
                    <InputText id="name" class="form-control" @bind-Value="_createModel.Name" placeholder="e.g. Apple Inc." />
                    <ValidationMessage For="() => _createModel.Name" class="text-danger small" />
                </div>
                <div class="col-sm-2">
                    <label for="price" class="form-label">Price</label>
                    <InputNumber id="price" class="form-control" @bind-Value="_createModel.Price" />
                    <ValidationMessage For="() => _createModel.Price" class="text-danger small" />
                </div>
                <div class="col-sm-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        }
                        Add Stock
                    </button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@if (_pagedResult is null)
{
    <p><em>Loading...</em></p>
}
else if (_pagedResult.TotalCount == 0)
{
    <p class="text-muted">No stocks yet. Add one above to get started.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th scope="col" style="cursor:pointer;" @onclick='() => SortBy("symbol")'>
                        Symbol @SortIndicator("symbol")
                    </th>
                    <th scope="col" style="cursor:pointer;" @onclick='() => SortBy("name")'>
                        Name @SortIndicator("name")
                    </th>
                    <th scope="col">Price</th>
                    <th scope="col">Last Updated</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var stock in _pagedResult.Items)
                {
                    <tr>
                        <td>@stock.Symbol</td>
                        <td>@stock.Name</td>
                        <td>@stock.Price.ToString("C")</td>
                        <td>@stock.LastUpdated.ToLocalTime().ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-2">
        <span class="text-muted small">
            Showing @((_currentPage - 1) * _pageSize + 1)–@(Math.Min(_currentPage * _pageSize, _pagedResult.TotalCount)) of @_pagedResult.TotalCount stocks
        </span>
        <nav aria-label="Stocks pagination">
            <ul class="pagination mb-0">
                <li class="page-item @(_currentPage <= 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="PreviousPage" disabled="@(_currentPage <= 1)">Previous</button>
                </li>
                @for (int p = 1; p <= _pagedResult.TotalPages; p++)
                {
                    var pageNum = p;
                    <li class="page-item @(pageNum == _currentPage ? "active" : "")">
                        <button class="page-link" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                    </li>
                }
                <li class="page-item @(_currentPage >= _pagedResult.TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="NextPage" disabled="@(_currentPage >= _pagedResult.TotalPages)">Next</button>
                </li>
            </ul>
        </nav>
    </div>
}

@code {
    private PagedResult<Stock>? _pagedResult;
    private int _currentPage = 1;
    private int _pageSize = 10;
    private string _sortBy = "symbol";
    private string _sortDir = "asc";

    private CreateStockRequest _createModel = new();
    private bool _isSubmitting;
    private string? _successMessage;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadStocksAsync();
    }

    private async Task LoadStocksAsync()
    {
        _pagedResult = await StockService.ListStocksAsync(_currentPage, _pageSize, _sortBy, _sortDir);
    }

    private async Task SortBy(string column)
    {
        if (_sortBy == column)
        {
            _sortDir = _sortDir == "asc" ? "desc" : "asc";
        }
        else
        {
            _sortBy = column;
            _sortDir = "asc";
        }
        _currentPage = 1;
        await LoadStocksAsync();
    }

    private MarkupString SortIndicator(string column)
    {
        if (_sortBy != column) return new MarkupString("<span class=\"text-muted\">⇅</span>");
        return _sortDir == "asc"
            ? new MarkupString("<span>↑</span>")
            : new MarkupString("<span>↓</span>");
    }

    private async Task GoToPage(int page)
    {
        _currentPage = page;
        await LoadStocksAsync();
    }

    private async Task PreviousPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            await LoadStocksAsync();
        }
    }

    private async Task NextPage()
    {
        if (_pagedResult is not null && _currentPage < _pagedResult.TotalPages)
        {
            _currentPage++;
            await LoadStocksAsync();
        }
    }

    private async Task HandleCreateAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var stock = await StockService.CreateStockAsync(_createModel);
            _successMessage = $"Stock '{stock.Symbol}' created successfully.";
            _createModel = new CreateStockRequest();
            _currentPage = 1;
            await LoadStocksAsync();
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (Exception)
        {
            _errorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
